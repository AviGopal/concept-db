{
  "name": "concept-db",
  "version": "0.3.0",
  "description": "Concept management vessel - manages concepts as impulses with graph relationships",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "apply-schema": "bun run scripts/apply-schema.ts",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@stdlib/random-base-beta": "^0.2.1",
    "hono": "^4.0.0",
    "ioredis": "^5.3.2",
    "nanoid": "^5.0.4",
    "onnxruntime-node": "^1.20.1",
    "surrealdb": "^2.0.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
