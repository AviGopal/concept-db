#!/usr/bin/env bash
#
# concept-db pre-commit hook.
#
# Mirrors the metabob-devbob super-repo hook with vessel-appropriate
# placement rules. Runs two layers in order:
#
#   1. Placement check — rejects newly-added or renamed-into entries that
#      violate the placement rules (only ADDED files are checked; modifying
#      existing tracked files is never blocked).
#   2. Secrets scan — gitleaks protect --staged.
#
# Bypass: `git commit --no-verify` (use sparingly).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
GREEN=$'\033[0;32m'
DIM=$'\033[2m'
NC=$'\033[0m'

# Allowed files at the vessel root (basename match, exact).
ROOT_ALLOWLIST=(
  CLAUDE.md
  README.md
  LICENSE
  LICENSE.md
  .gitignore
  .gitattributes
  .editorconfig
  .nvmrc
  .tool-versions
  .prettierrc
  .prettierrc.json
  .prettierrc.yaml
  .prettierignore
  .eslintrc.js
  .eslintrc.json
  .eslintignore
  .dockerignore
  .env.example
  package.json
  bun.lock
  bunfig.toml
  package-lock.json
  yarn.lock
  pnpm-lock.yaml
  tsconfig.json
  tsconfig.base.json
  Dockerfile
  vitest.config.ts
  vite.config.ts
  biome.json
  vessel.json
)

# Allowed top-level directories for newly-added files.
ALLOWED_TOPLEVEL_DIRS=(
  src
  test
  tests
  e2e
  docs
  scripts
  sql
  migrations
  packages
  examples
  fixtures
  cli
  bin
  public
  .github
  .minibob
)

ARTEFACT_EXTENSIONS='png|jpg|jpeg|gif|webp|svg|bmp|ico|mp4|mov|webm|pdf|zip|tar|gz|tgz'

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=AR)

if [[ ${#STAGED[@]} -eq 0 ]]; then
  exit 0
fi

violations=()

is_root_allowlisted() {
  local name="$1"
  for entry in "${ROOT_ALLOWLIST[@]}"; do
    [[ "$name" == "$entry" ]] && return 0
  done
  [[ "$name" == .env.*.example ]] && return 0
  [[ "$name" == Dockerfile.* ]] && return 0
  [[ "$name" == tsconfig.*.json ]] && return 0
  return 1
}

is_under_allowed_toplevel() {
  local path="$1"
  local first="${path%%/*}"
  for dir in "${ALLOWED_TOPLEVEL_DIRS[@]}"; do
    [[ "$first" == "$dir" ]] && return 0
  done
  return 1
}

flag() {
  local file="$1" reason="$2" remedy="$3"
  violations+=("${file}|${reason}|${remedy}")
}

for file in "${STAGED[@]}"; do
  base="$(basename "$file")"
  ext="${base##*.}"
  ext_lower="${ext,,}"

  if [[ "$file" == */* ]]; then
    if ! is_under_allowed_toplevel "$file"; then
      flag "$file" \
        "new file in unrecognised top-level directory" \
        "move under src/, test{,s}/, docs/, scripts/, sql/, migrations/, examples/, or fixtures/"
      continue
    fi
  else
    if ! is_root_allowlisted "$base"; then
      case "$base" in
        *.md)
          flag "$file" \
            "new markdown file at vessel root" \
            "stateless reference docs go in docs/; one-off writeups belong in commit messages, not the tree"
          ;;
        *.sh|*.ts|*.tsx|*.js|*.mjs|*.cjs|*.py)
          flag "$file" \
            "new script at vessel root" \
            "operational scripts go in scripts/; source goes in src/"
          ;;
        test-*|*-test.*|*.test.*|tests-*)
          flag "$file" \
            "new test file at vessel root" \
            "tests live in test/ or tests/ alongside the code they cover"
          ;;
        *.html|*.txt|*.yaml|*.yml|*.json|*.toml|*.surql|*.sql)
          flag "$file" \
            "new data/config file at vessel root" \
            "move under the owning area (src/, scripts/, sql/, examples/, fixtures/) — root holds project metadata only"
          ;;
        *)
          if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
            flag "$file" \
              "new binary/artefact at vessel root" \
              "binary assets go in docs/assets/; build outputs and screenshots should be gitignored"
          else
            flag "$file" \
              "new file at vessel root not in allowlist" \
              "extend ROOT_ALLOWLIST in scripts/git-hooks/pre-commit only if the file is genuinely vessel-wide metadata"
          fi
          ;;
      esac
      continue
    fi
  fi

  if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
    if [[ "$file" != docs/assets/* && "$file" != docs/*/assets/* ]]; then
      flag "$file" \
        "binary/artefact outside docs/assets/" \
        "screenshots are session artefacts (gitignore them); illustrative assets go in docs/assets/<topic>/"
    fi
  fi
done

if [[ ${#violations[@]} -gt 0 ]]; then
  printf '%s\n' "${RED}━━━ concept-db placement check failed ━━━${NC}"
  printf '%s\n\n' "${DIM}rules: scripts/git-hooks/README.md${NC}"

  for v in "${violations[@]}"; do
    IFS='|' read -r file reason remedy <<<"$v"
    printf '  %s%s%s\n' "${YELLOW}✗${NC} " "$file" ""
    printf '      %sreason:%s %s\n' "$DIM" "$NC" "$reason"
    printf '      %sfix:   %s %s\n\n' "$DIM" "$NC" "$remedy"
  done

  cat <<EOF
${DIM}Why this exists${NC}
  concept-db is a TypeScript/Bun vessel that resolves concept-graph shapes.
  The tree should hold src/, test{,s}/, sql/, docs/, scripts/ — and a small
  set of project metadata at root. Loose JSON, ad-hoc test scripts, and
  one-shot writeups accumulate as cruft. Use commit history (git log + git
  blame) for everything that's only true at one point in time.

${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(use sparingly)${NC}
EOF

  exit 1
fi

# ─── secrets scan ───
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner 2>&1; then
    printf '\n%s\n' "${RED}━━━ gitleaks: secrets detected in staged diff ━━━${NC}"
    cat <<EOF
${DIM}What to do${NC}
  1. Remove the secret from the file before committing.
  2. Rotate the leaked credential immediately — assume it is compromised
     once it has touched the staging tree.
  3. False positive? Add an inline allowlist comment:
       ${DIM}some-value  # gitleaks:allow${NC}

${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(only after rotating the credential)${NC}
EOF
    exit 1
  fi
else
  printf '%s\n' "${YELLOW}note:${NC} gitleaks is not installed; secrets scan was skipped."
  printf '%s\n' "      install: ${DIM}brew install gitleaks${NC} | ${DIM}go install github.com/gitleaks/gitleaks/v8@latest${NC}"
fi

exit 0
